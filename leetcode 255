import java.util.LinkedList;
import java.util.Queue;

class MyStack {

    private Queue<Integer> queue;

    public MyStack() {
        queue = new LinkedList<>();
    }
    
    /** Push element x onto stack. */
    public void push(int x) {
        // 1. Add the new element to the back of the queue
        queue.add(x);
        
        // 2. Rotate the queue so the newly added element comes to the front.
        // We do this by pulling elements from the front and pushing them to the back,
        // repeating this for all elements except the one we just added.
        int size = queue.size();
        for (int i = 0; i < size - 1; i++) {
            queue.add(queue.remove());
        }
    }
    
  
    public int pop() {
       
        return queue.remove();
    }
    
   
    public int top() {
        
        return queue.peek();
    }
 
    public boolean empty() {
        return queue.isEmpty();
    }
}
